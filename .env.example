# Public app URL (used in unsubscribe links and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Leadloop

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=

# Apollo.io (needs People Search + Enrichment access)
APOLLO_API_KEY=

# Resend: sending + inbound replies
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Domain whose MX points at Resend inbound, e.g. in.acme.com
INBOUND_EMAIL_DOMAIN=

# Random strings: openssl rand -hex 32
CRON_SECRET=
LINK_SIGNING_SECRET=

# Stripe (optional; enables credit top-ups)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPPORT_EMAIL=
