# Public app URL (used in unsubscribe links and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Leadloop

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=

# Apollo.io (needs People Search + Enrichment access)
APOLLO_API_KEY=

# Resend: sending + inbound replies
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Domain whose MX points at Resend inbound, e.g. in.acme.com
INBOUND_EMAIL_DOMAIN=

# Random strings: openssl rand -hex 32
CRON_SECRET=
LINK_SIGNING_SECRET=

# Stripe (optional; enables credit top-ups)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Flutterwave (credit top-ups by card, bank transfer, mobile money)
FLUTTERWAVE_SECRET_KEY=
# Same value as "Secret hash" in Flutterwave > Settings > Webhooks
FLUTTERWAVE_WEBHOOK_HASH=
# USD (default) or e.g. NGN; for non-USD also set how many units equal $1
FLUTTERWAVE_CURRENCY=USD
FLUTTERWAVE_USD_RATE=
